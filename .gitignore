# Cloudflare API token: a live secret with DNS and API-token scope.
# relay/.env holds the copy the tooling reads; this is the original paste.
CF Jobby Mobilemonero.txt

# Credential backups of relay/.env. Each holds 23-26 live keys
# (Supabase service role, OpenRouter, Resend) and was untracked AND
# unignored, so a git add -A at the root would have committed them.
relay/.env.bak*
local-supabase/.env


# relay/server.js is tracked again as of 2026-10-10 (XMRT Nexus aside work);
# the working copy is canonical — it is what actually runs the stack.

# Runtime JSON state written by the relay (task lists, activity log, session state).
# It changes on every request and is not source.
relay/relay-data/

# resume_server's rotating access/error log. Runtime output, not source.
jobby-mcjobberson/resume_server.log*

# resume_server / vite / proxy logs, and Python bytecode caches.
jobby-mcjobberson/*.log*
jobby-mcjobberson/**/__pycache__/
**/__pycache__/

# Derived recognition vectors. Rebuilt from C:\Users\PureTrek\Desktop\Faces\Faces
# by tools/_enrol.py - 33 x 512 floats, all reproducible, and useless without
# the dataset. The provenance sidecar is runtime state that changes on every
# enrolment, so it must not be committed either: a stale shot count checked
# into git is worse than none, because it looks authoritative.
face-service/identities/

# ── Installed toolchains, not source ───────────────────────────────────────
# A PostgreSQL install (9,016 files) and two JDK copies (2,902 files) sat in
# the working tree. They are builds: reproducible from the installers, and the
# reason `git status` was unreadable. Nothing under them was ever tracked.
pg/
tools/
jdk17*/

# ── Runtime state, caches and logs ─────────────────────────────────────────
# relay-data/ holds the supervisor's state file, the browser profile and the
# cron log - all of it changes on every request. The things in it that ARE
# source stay tracked: the job list, the record of removed jobs, and the SQL.
relay-data/*
!relay-data/cron-jobs.json
!relay-data/cron-job-removed.json
!relay-data/CRON-JOBS-REVIEW.md
!relay-data/create_inbox_table.sql
!relay-data/registry-ddl.sql
!relay-data/schema-pfp-onboarding.sql
local-supabase/storage-data/
local-supabase/.deno_cache/
logs/

# ── Test and evidence output ──────────────────────────────────────────────
_probe_results/
_pfp_prints/
_pfp_booking/
dogfood-evidence/
backups/postgres/

# ── Model weights and service output ──────────────────────────────────────
face-service/models/
face-service/deck-assets/
face-service/graytech/*.log
face-service/graytech/*.err

# ── Copies of other checkouts, living inside this one ─────────────────────
