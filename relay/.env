RESEND_API_KEY=re_BrGV9sSL_3b7F6XdV1NE8QufC1FNze69E
RESEND_WEBHOOK_SECRET=whsec_iIYkYX4iQ9GOLkUaOK2LVaXHrmmFHt8K
MUAPI_API_KEY=060188b635eecb7ba11b3b634d3f373463c458cfb9cd0624cdab69a197e5b119
RESEND_XMRT_API_KEY=re_8ypZddMZ_AgCWwU5gn6Vj5HkoyAq5UdM4
RESEND_MM_WEBHOOK_SECRET=whsec_dYj27oFu13iJd8DqTFk/hnaeYL6VB0+k

# Resend (hamptons31harbor - 31 Harbor)
RESEND_31HARBOR_API_KEY=re_VmTXTY9N_AyjCXtoRkWPZ5h715bDk2Muu
RESEND_31HARBOR_WEBHOOK_SECRET=whsec_3HQc70Q3l/Ml22DQDa3zEGJS86rKgv0T

# Cloudflare Access Service Tokens (added 2026-05-24)
CF_ACCESS_CLIENT_ID_ELIZA=CF_ACCESS_CLIENT_ID_REMOVED
CF_ACCESS_CLIENT_SECRET_ELIZA=CF_ACCESS_CLIENT_SECRET_REMOVED
CF_ACCESS_CLIENT_ID_VEX=CF_ACCESS_CLIENT_ID_REMOVED
CF_ACCESS_CLIENT_SECRET_VEX=CF_ACCESS_CLIENT_SECRET_REMOVED
CF_ACCESS_CLIENT_ID_HERMES=CF_ACCESS_CLIENT_ID_REMOVED
CF_ACCESS_CLIENT_SECRET_HERMES=CF_ACCESS_CLIENT_SECRET_REMOVED

# Ollama Pro - Primary LLM provider (priority 1)
OLLAMA_PRIORITY=high

# Ollama Pro API Key (Primary LLM Provider)
# Real key lives in local-supabase/.env — relay/.env is loaded second with
# override:true by local-supabase/server.mjs, so a placeholder here would
# clobber the real key and cause ai-chat to hang trying ollama.com with a
# fake credential.
# OLLAMA_API_KEY=OLLAMA_API_KEY_REMOVED
# OLLAMA_HERMES_API_KEY=OLLAMA_HERMES_API_KEY_REMOVED

# Backup inference providers (used only if Ollama Pro fails)
# 2026-06-10 sweep verified:
#   - DEEPSEEK_API_KEY: working (sk-... format, accepted by DeepSeek API)
#   - GEMINI_API_KEY: REMOVED — 403 from generativelanguage.googleapis.com;
#     the AQ.Ab8R... value is an OAuth/refresh token, not a usable Gemini API key
#   - KIMI_API_KEY: REMOVED — 401 from api.moonshot.cn; the sk-kimi-... value
#     was a placeholder, not a real key
#   - OPENROUTER_API_KEY: REMOVED — was empty
# All three removed keys had ZERO consumers in relay/* and local-supabase/*
# (verified via grep). If a future feature needs a real Gemini/Kimi/OpenRouter
# key, populate the variable and add the consumer code.
# DeepSeek key lives in local-supabase/.env — DO NOT clobber with a placeholder here
# GEMINI_API_KEY=
# KIMI_API_KEY=
# OPENROUTER_API_KEY=
AI_CHAT_DEBUG_LOG=1
LOCAL_OLLAMA_ONLY=1

# NEXT_PUBLIC_ prefix so ai-chat's supabase client finds the local stack
# instead of defaulting to the dead cloud supabase URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local Ollama model for tool calling — gemma3-it-qat-tools is purpose-built
# for function calling; fast enough (~8.9GB) to respond within 20s on most queries.
OLLAMA_LOCAL_MODEL=aliafshar/gemma3-it-qat-tools:latest

# LOCAL_OLLAMA_ONLY=1 — removed 2026-06-17: this flag bumps ollama_local
# (priority -2) ahead of cloud Ollama (priority 0), causing the cascade to
# try loading gemma4 (9.6GB) first with a 120s timeout. The 120s request
# timeout expires before the cascade reaches the working cloud Ollama
# provider. Cloud Ollama (deepseek-v4-flash:cloud) is the intended primary
# provider per joe 2026-06-10. 
