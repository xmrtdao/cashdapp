# XMRT DAO Relay — Environment Configuration
# Local Postgres (replaces cloud Supabase for DB operations)
LOCAL_DB_MODE=true
LOCAL_DATABASE_URL=postgres://postgres@127.0.0.1:5432/xmrt_suite

# Primary: Local Supabase (drop-in replacement on port 54321)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key
SUPABASE_ANON_KEY=local-anon-key
# Local edge function runtime for cron engine (same as SUPABASE_URL)
LOCAL_RUNTIME_URL=http://127.0.0.1:54321

# Cloud Supabase — kept as FALLBACK only (free tier may go away)
# Uncomment to fall back to cloud: `set SUPABASE_URL=https://vawouugtzwmejxqkeqqj.supabase.co`
# SUPABASE_URL=https://vawouugtzwmejxqkeqqj.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_REMOVED
# SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_REMOVED

# Supabase CLI
SUPABASE_ACCESS_TOKEN=SUPABASE_PAT_REMOVED

# Ollama (local AI) — PRIMARY provider for all suites
# OLLAMA_MODEL is the default model for Ollama Pro Cloud calls
# Per Vex/joe 2026-06-10: deepseek-v4-flash:cloud is the system default
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-v4-flash:cloud

# Hermes (phone agent)
HERMES_ENDPOINT=http://192.168.14.115:9090

# Relay
RELAY_PORT=8080
NODE_ENV=production

# GitHub
GITHUB_REPO=xmrtdao/mobilemonero
GITHUB_TOKEN=GITHUB_PAT_REMOVED

