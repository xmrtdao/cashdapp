# XMRT DAO Relay — Environment Configuration
# Local Postgres (replaces cloud Supabase for DB operations)
LOCAL_DB_MODE=true
LOCAL_DATABASE_URL=postgres://postgres@127.0.0.1:5432/xmrt_suite

# Primary: Local Supabase (drop-in replacement on port 54321)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key
SUPABASE_ANON_KEY=local-anon-key
# Local edge function runtime for cron engine (same as SUPABASE_URL)
LOCAL_RUNTIME_URL=http://127.0.0.1:54321

# Cloud Supabase — kept as FALLBACK only (free tier may go away)
# Uncomment to fall back to cloud: `set SUPABASE_URL=https://vawouugtzwmejxqkeqqj.supabase.co`
# SUPABASE_URL=https://vawouugtzwmejxqkeqqj.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_REMOVED
# SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_REMOVED

# Supabase CLI
SUPABASE_ACCESS_TOKEN=SUPABASE_PAT_REMOVED

# Ollama (local AI) — PRIMARY provider for all suites
# OLLAMA_MODEL is the default model for Ollama Pro Cloud calls
# Per Vex/joe 2026-06-10: deepseek-v4-flash:cloud is the system default
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-v4-flash:cloud

# Hermes (phone agent)
HERMES_ENDPOINT=http://192.168.14.115:9090

# Relay
RELAY_PORT=8080
NODE_ENV=production

# GitHub
GITHUB_REPO=xmrtdao/mobilemonero
GITHUB_TOKEN=GITHUB_PAT_REMOVED

# Resend (pfpattendants - Party Favor Photo)
RESEND_API_KEY=RESEND_API_KEY_REMOVED
RESEND_WEBHOOK_SECRET=RESEND_WEBHOOK_SECRET_REMOVED
MUAPI_API_KEY=MUAPI_API_KEY_REMOVED
RESEND_XMRT_API_KEY=RESEND_XMRT_API_KEY_REMOVED
RESEND_MM_WEBHOOK_SECRET=RESEND_MM_WEBHOOK_SECRET_REMOVED

# Cloudflare Access Service Tokens (added 2026-05-24)
CF_ACCESS_CLIENT_ID_ELIZA=CF_ACCESS_CLIENT_ID_REMOVED
CF_ACCESS_CLIENT_SECRET_ELIZA=CF_ACCESS_CLIENT_SECRET_REMOVED
CF_ACCESS_CLIENT_ID_VEX=CF_ACCESS_CLIENT_ID_REMOVED
CF_ACCESS_CLIENT_SECRET_VEX=CF_ACCESS_CLIENT_SECRET_REMOVED
CF_ACCESS_CLIENT_ID_HERMES=CF_ACCESS_CLIENT_ID_REMOVED
CF_ACCESS_CLIENT_SECRET_HERMES=CF_ACCESS_CLIENT_SECRET_REMOVED

# Ollama Pro - Primary LLM provider (priority 1)
OLLAMA_PRIORITY=high

# Ollama Pro API Key (Primary LLM Provider)
OLLAMA_API_KEY=OLLAMA_API_KEY_REMOVED
OLLAMA_HERMES_API_KEY=OLLAMA_HERMES_API_KEY_REMOVED

# Backup inference providers (used only if Ollama Pro fails)
# 2026-06-10 sweep verified:
#   - DEEPSEEK_API_KEY: working (sk-... format, accepted by DeepSeek API)
#   - GEMINI_API_KEY: REMOVED — 403 from generativelanguage.googleapis.com;
#     the AQ.Ab8R... value is an OAuth/refresh token, not a usable Gemini API key
#   - KIMI_API_KEY: REMOVED — 401 from api.moonshot.cn; the sk-kimi-... value
#     was a placeholder, not a real key
#   - OPENROUTER_API_KEY: REMOVED — was empty
# All three removed keys had ZERO consumers in relay/* and local-supabase/*
# (verified via grep). If a future feature needs a real Gemini/Kimi/OpenRouter
# key, populate the variable and add the consumer code.
DEEPSEEK_API_KEY=DEEPSEEK_API_KEY_REMOVED
# GEMINI_API_KEY=
# KIMI_API_KEY=
# OPENROUTER_API_KEY=
AI_CHAT_DEBUG_LOG=1
LOCAL_OLLAMA_ONLY=1 
